{
  "name": "cycling-reader",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "extract": "tsx src/ingest/extraction/cli.ts",
    "ingest": "tsx --env-file-if-exists=.dev.vars src/ingest/cli.ts",
    "migrate": "tsx --env-file-if-exists=.dev.vars scripts/migrate.ts",
    "golden:update": "tsx scripts/update-golden.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^26.1.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
