{
  "name": "cycling-reader",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "extract": "tsx src/ingest/extraction/cli.ts",
    "ingest": "tsx --env-file-if-exists=.dev.vars src/ingest/cli.ts",
    "migrate": "tsx --env-file-if-exists=.dev.vars scripts/migrate.ts",
    "passphrase": "tsx scripts/passphrase.ts",
    "golden:update": "tsx scripts/update-golden.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "hono": "^4.13.1",
    "jsdom": "^26.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260809.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
