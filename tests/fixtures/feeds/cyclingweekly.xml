                                                                                                                                                                                                                                    <media:description><![CDATA[Bob Montgomery and grandson Tom Malcolm at the end of their ride across Australia]]></media:description>                                                            <media:text><![CDATA[Bob Montgomery and grandson Tom Malcolm at the end of their ride across Australia]]></media:text>
