{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,

    // The Worker's JSX runs on the server and never hydrates, so it is Hono's
    // own rather than React's. This lives in the root configuration because
    // wrangler builds the Worker with esbuild and takes its JSX settings from
    // here — see `tsconfig.worker.json` for the rest of the Worker's types.
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  // The Node half: ingest, Expiry, Extraction, and the scripts around them.
  // The Worker is checked separately because it runs on workerd, where `node`
  // types are a lie and D1 is a global.
  "include": [
    "src/ingest",
    "src/expiry",
    "src/shared",
    "scripts",
    "tests/node",
    "tests/support",
    "vitest.config.ts"
  ]
}
